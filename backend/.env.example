# CalTracker Environment Configuration
# MongoDB connection string (local or MongoDB Atlas free tier URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
DB_NAME=caltracker_db

# Google Gemini API key for real-time AI food image recognition (optional, app has offline fallback)
GEMINI_API_KEY=

# Server Port
PORT=8000
HOST=0.0.0.0
